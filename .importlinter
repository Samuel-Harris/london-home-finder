[importlinter]
root_packages =
    lhf
include_external_packages = True

[importlinter:contract:package-layers]
name = Apps and tools are independent above feature libraries above shared libs
type = layers
layers =
    lhf.api | lhf.scraper | lhf.db_app | lhf.mortgage_cli
    lhf.listings | lhf.mortgage
    lhf.db

[importlinter:contract:listings-public-interface]
name = Listings private modules are only imported inside the listings package
type = protected
protected_modules =
    lhf.listings._listing_row
allowed_importers =
    lhf.listings
    lhf.db_app

[importlinter:contract:mortgage-public-interface]
name = Mortgage private modules are only imported inside the mortgage package
type = protected
protected_modules =
    lhf.mortgage._schedule
allowed_importers =
    lhf.mortgage
